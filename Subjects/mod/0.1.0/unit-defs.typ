// Unit names -> symbols. Imported by units.typ as the `units` module.
// The names work in strings (`unit("kilo gram")`); in math, import what you
// need (`#import units: kg, joule`) — single letters (m, s, N, ...) need no import.
// Not exported: `as` (keyword) — use "atto second".

#let gram = "g"

// SI base units
#let ampere = "A"
#let candela = "cd"
#let kelvin = "K"
#let kilogram = "kg"
#let metre = "m"
#let meter = metre
#let mole = "mol"
#let second = "s"

// Coherent derived units
#let becquerel = "Bq"
#let degreeCelsius = "°C"
#let coulomb = "C"
